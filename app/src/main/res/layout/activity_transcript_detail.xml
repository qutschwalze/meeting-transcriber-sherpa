<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#1A1A2E">

    <!-- Toolbar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#0F0F23"
        app:titleTextColor="#E0E0E0"
        app:navigationIcon="@drawable/ic_back"
        app:navigationIconTint="#E0E0E0" />

    <!-- Metadata bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:background="#16213E"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvDetailDate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#00D4AA"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDetailLang"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#888888"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Full transcript -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvFullTranscript"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#CCCCCC"
            android:textSize="15sp"
            android:lineSpacingMultiplier="1.5"
            android:textIsSelectable="true" />

    </ScrollView>

    <!-- Action bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:background="#0F0F23"
        android:gravity="center">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDetailCopy"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Kopieren"
            android:textColor="#00D4AA"
            app:strokeColor="#00D4AA"
            android:layout_marginEnd="6dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDetailShare"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Teilen"
            android:textColor="#00D4AA"
            app:strokeColor="#00D4AA"
            android:layout_marginHorizontal="6dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDetailDelete"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Löschen"
            android:textColor="#E53935"
            app:strokeColor="#E53935"
            android:layout_marginStart="6dp" />

    </LinearLayout>

</LinearLayout>
