<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="#16213E"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeColor="#2A2A4A"
    app:strokeWidth="1dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Date & Time -->
        <TextView
            android:id="@+id/tvDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#00D4AA"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <!-- Language badge -->
        <TextView
            android:id="@+id/tvLanguage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#888888"
            android:textSize="11sp"
            android:layout_marginBottom="8dp" />

        <!-- Preview text -->
        <TextView
            android:id="@+id/tvPreview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#999999"
            android:textSize="13sp"
            android:maxLines="3"
            android:ellipsize="end"
            android:lineSpacingMultiplier="1.3" />

        <!-- Action buttons row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end"
            android:layout_marginTop="12dp">

            <ImageButton
                android:id="@+id/btnOpen"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_open"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Öffnen"
                android:scaleType="centerInside"
                android:layout_marginEnd="8dp"
                app:tint="#00D4AA" />

            <ImageButton
                android:id="@+id/btnCopyItem"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_copy"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Kopieren"
                android:scaleType="centerInside"
                android:layout_marginEnd="8dp"
                app:tint="#00D4AA" />

            <ImageButton
                android:id="@+id/btnShareItem"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_share"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Teilen"
                android:scaleType="centerInside"
                android:layout_marginEnd="8dp"
                app:tint="#00D4AA" />

            <ImageButton
                android:id="@+id/btnDelete"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_delete"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Löschen"
                android:scaleType="centerInside"
                app:tint="#E53935" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
